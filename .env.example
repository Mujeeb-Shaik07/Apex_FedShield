# Copy this file to .env and fill in REAL values before running.
# NEVER commit .env to version control.
# See README.md for setup instructions.

DATABASE_URL=sqlite:///./threat_intelligence.db
PRIVACY_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars
PRIVACY_KEY_VERSION=1

# Legacy simulation client keys (used by simulate_clients.py / simulate_network.py)
# Real clients are now managed through the Admin UI.
CLIENT_A_API_KEY=replace-client-a-key
CLIENT_B_API_KEY=replace-client-b-key
CLIENT_C_API_KEY=replace-client-c-key

# ----------------------------------------------------------------
# ADMIN BOOTSTRAP CREDENTIALS
# Used ONCE on first startup to create the MAIN_ADMIN account.
# The bootstrap password is immediately hashed with Argon2; the
# plaintext is never stored anywhere after that point.
# Change these before any real deployment.
# ----------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.example
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-hex-secret

# Admin JWT token lifetime in minutes (default: 30)
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30
